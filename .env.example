# =============================================================================
# Apollo Billing — environment configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Values marked ⚠  are REQUIRED — setup will error if they are empty.
# Values marked ✦  are auto-generated by ./setup.sh --service billing if left empty.
#
# NOTE: Postgres, Redis, and nginx are NOT owned by the billing stack.
#       They are provided by the platform stack. Point PLATFORM_DB_* and
#       REDIS_* at the platform's containers/host.
# =============================================================================

# ── Networking ────────────────────────────────────────────────────────────────
# Name of the external Docker network created by the platform stack.
PLATFORM_NETWORK=platform_default

# ── Runtime ───────────────────────────────────────────────────────────────────
# Environment name. Controls logging verbosity and several runtime defaults.
# Must be one of: development | test | production.
# Aliases: APOLLO_BILLING_ENV (legacy, still accepted).
APP_ENV=production

# TCP port the Ktor server binds to inside the container.
BILLING_PORT=3040

# Maximum incoming request body size in bytes. Default: 10 MB (10485760).
# REQUEST_BODY_LIMIT_BYTES=10485760

# Set to true to expose a Prometheus /metrics endpoint.
METRICS_ENABLED=false

# Comma-separated extra redirect allowlist domains for checkout/portal returnUrl
# (merged with built-in apollodeploy.com + apollodeploy.local defaults).
# CHECKOUT_REDIRECT_ALLOWED_DOMAINS=

# Comma-separated list of origins the CORS middleware will accept.
# Empty = allow all origins (fine for local dev, not for prod).
CORS_ORIGINS=

# ── Platform database ─────────────────────────────────────────────────────────
# Read/write — billing_app role (CRUD on billing_customers, billing_subscriptions
# + SELECT on platform_apps). Copy BILLING_APP_DB_PASS from platform installer.
PLATFORM_DB_HOST=postgres
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=apollo_deploy_platform
PLATFORM_DB_USER=billing_app
PLATFORM_DB_PASSWORD=                           # ⚠  required — platform installer: BILLING_APP_DB_PASS

# ── billing_superuser — shared read-only role ─────────────────────────────────
# Used for two read-only pools: platform DB (apikey) + signal DB (signal tables).
# Both pools use the same billing_superuser role and password.
# Copy BILLING_SUPERUSER_DB_PASS from the platform installer output.
BILLING_SUPERUSER_PASSWORD=                     # ⚠  required — platform installer: BILLING_SUPERUSER_DB_PASS

# Signal database — billing_superuser connects here for signal table reads.
SIGNAL_DB_HOST=postgres
SIGNAL_DB_PORT=5432
SIGNAL_DB_NAME=apollo_deploy_signal

# ── Redis ─────────────────────────────────────────────────────────────────────
# Provided by the platform stack. Copy REDIS_PASSWORD from the platform
# installer output into REDIS_PASSWORD.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                                 # ⚠  required — platform installer: REDIS_PASSWORD

# Optional: Redis logical database index (0–15). Default: 0.
# REDIS_DB=0

# ── Platform OAuth2 (audit-log ingestion + /internal/* service calls) ─────────
# Register billing as an OAuth client via: bun run oauth:register-clients
# Then set the returned client_id and client_secret here.
PLATFORM_URL=https://api.platform.apollodeploy.com
PLATFORM_AUDIENCE_URL=                             # ⚠  required — JWT resource/audience
PLATFORM_CLIENT_ID=                             # ⚠  required for audit logs
PLATFORM_CLIENT_SECRET=                         # ⚠  required for audit logs

# ── IAM / OAuth M2M inbound (guards /internal/* routes) ──────────────────────
# These values must match the platform's configuration exactly.
# After registering billing as an OAuth client and registering its callers
# (e.g. platform + signal), add each caller's client_id to OAUTH_SERVICE_CLIENT_IDS.
#
# AUTH_JWKS_URL            — where to fetch EdDSA public keys.
#                            In Docker use http://apollo-platform:3000/auth/jwks —
#                            the public PLATFORM_URL hostname often does not resolve
#                            inside the container network. Defaults to {PLATFORM_URL}/auth/jwks.
# AUTH_OAUTH_ISSUER_URL    — expected `iss` claim in incoming tokens (required)
# AUTH_OAUTH_VALID_AUDIENCES — expected `aud` claim(s), comma-separated (required)
# OAUTH_SERVICE_CLIENT_IDS — comma-separated OAuth client_id(s) allowed to call /internal/*
#                            Fails closed when empty. Include platform + signal client_ids.
AUTH_JWKS_URL=http://apollo-platform:3000/auth/jwks
AUTH_OAUTH_ISSUER_URL=                          # ⚠  required
AUTH_OAUTH_VALID_AUDIENCES=                     # ⚠  required
OAUTH_SERVICE_CLIENT_IDS=                       # ⚠  required — platform + signal client_ids
IAM_REQUEST_TIMEOUT_MS=5000

# ── Polar ─────────────────────────────────────────────────────────────────────
POLAR_API_KEY=                                  # ⚠  required
POLAR_WEBHOOK_SECRET=                           # ✦  auto-generated if blank
POLAR_API_BASE_URL=https://api.polar.sh

# ── SDK publishing ───────────────────────────────────────────────────────────
# TypeScript SDK publishing.
NPM_TOKEN=
NPM_PUBLISH_ACCESS=restricted

# OpenAPI-generated JVM SDK coordinates.
TESSERACT_JAVA_GROUP_ID=com.apollodeploy
TESSERACT_JAVA_ARTIFACT_ID=billing-sdk

# Maven Central Portal credentials and an ASCII-armored GPG private key.
# In GitHub Actions these are populated from repository secrets.
ORG_GRADLE_PROJECT_mavenCentralUsername=
ORG_GRADLE_PROJECT_mavenCentralPassword=
ORG_GRADLE_PROJECT_signingInMemoryKey=
ORG_GRADLE_PROJECT_signingInMemoryKeyId=
ORG_GRADLE_PROJECT_signingInMemoryKeyPassword=

# Optional POM metadata.
POM_URL=https://github.com/apollo-deploy/apollo-billing-api
POM_SCM_URL=https://github.com/apollo-deploy/apollo-billing-api
POM_SCM_CONNECTION=scm:git:https://github.com/apollo-deploy/apollo-billing-api.git
POM_SCM_DEVELOPER_CONNECTION=scm:git:ssh://git@github.com/apollo-deploy/apollo-billing-api.git
POM_DEVELOPER_ID=apollo-deploy
POM_DEVELOPER_NAME="Apollo Deploy"
