# =============================================================================
# Apollo Billing — environment configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Values marked ⚠  are REQUIRED — install.sh will error if they are empty.
# Values marked ✦  are auto-generated by install.sh if left empty.
#
# NOTE: Postgres and Redis are NOT owned by the billing stack.
#       Both services are provided by the platform (apollo-deploy) stack.
#       Point PLATFORM_DB_* and REDIS_* at the platform's containers/host.
# =============================================================================

# ── Networking ────────────────────────────────────────────────────────────────
# Host address:port nginx binds for HTTPS.
BILLING_BIND=0.0.0.0:443

# Host address:port nginx binds for HTTP (redirects to HTTPS).
BILLING_HTTP_BIND=0.0.0.0:80

# Directory containing server.crt and server.key for nginx TLS.
# For local dev: openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
#   -keyout nginx/certs/server.key -out nginx/certs/server.crt -subj '/CN=localhost'
TLS_CERT_DIR=./nginx/certs

# Name of the external Docker network created by the platform stack.
# Billing joins this network to reach postgres and redis by their service hostnames.
# Default matches the platform compose project name (scripts/platform/ directory).
PLATFORM_NETWORK=platform_default

# ── Platform database ─────────────────────────────────────────────────────────
# Read/write — billing_app role (CRUD on billing_customers, billing_subscriptions
# + SELECT on platform_apps). Copy BILLING_APP_DB_PASS from platform installer.
PLATFORM_DB_HOST=postgres
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=apollo_deploy_platform
PLATFORM_DB_USER=billing_app
PLATFORM_DB_PASSWORD=                           # ⚠  required — platform installer: BILLING_APP_DB_PASS

# ── billing_superuser — shared read-only role ─────────────────────────────────
# Used for two read-only pools: platform DB (apikey) + signal DB (signal tables).
# Both pools use the same billing_superuser role and password.
# Copy BILLING_SUPERUSER_DB_PASS from the platform installer output.
BILLING_SUPERUSER_PASSWORD=                     # ⚠  required — platform installer: BILLING_SUPERUSER_DB_PASS

# Signal database — billing_superuser connects here for signal table reads.
SIGNAL_DB_HOST=postgres
SIGNAL_DB_PORT=5432
SIGNAL_DB_NAME=apollo_deploy_signal

# ── Redis ─────────────────────────────────────────────────────────────────────
# Provided by the platform stack. Copy REDIS_PASSWORD from the platform
# installer output into REDIS_PASSWORD.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                                 # ⚠  required — platform installer: REDIS_PASSWORD

# ── Platform OAuth2 (audit-log ingestion + /internal/* service calls) ─────────
# Register billing as an OAuth client via: bun run oauth:register-clients
# Then set the returned client_id and client_secret here.
PLATFORM_URL=https://api.platform.apollodeploy.com
PLATFORM_CLIENT_ID=                             # ⚠  required for audit logs
PLATFORM_CLIENT_SECRET=                         # ⚠  required for audit logs

# ── IAM / OAuth M2M inbound (guards /internal/* routes) ──────────────────────
# These values must match the platform's configuration exactly.
# After registering billing as an OAuth client and registering its callers
# (e.g. signal), add each caller's client_id to IAM_SERVICE_CLIENT_IDS.
#
# IAM_JWKS_URL       — where to fetch EdDSA public keys (default: {PLATFORM_URL}/auth/jwks)
# IAM_ISSUER_URL     — expected `iss` claim in incoming tokens (default: PLATFORM_URL)
# AUTH_OAUTH_VALID_AUDIENCES — expected `aud` claim(s), comma-separated (default: PLATFORM_URL)
# IAM_SERVICE_CLIENT_IDS — comma-separated OAuth client_id(s) allowed to call /internal/*
#                           Fails closed when empty. Add signal's client_id here.
IAM_JWKS_URL=                                   # optional (defaults to ${PLATFORM_URL}/auth/jwks)
IAM_ISSUER_URL=                                 # optional (defaults to PLATFORM_URL)
AUTH_OAUTH_VALID_AUDIENCES=                     # optional (defaults to PLATFORM_URL)
IAM_SERVICE_CLIENT_IDS=                         # ⚠  required — add signal's OAuth client_id
IAM_REQUEST_TIMEOUT_MS=5000

# ── Polar ─────────────────────────────────────────────────────────────────────
POLAR_API_KEY=                                  # ⚠  required
POLAR_WEBHOOK_SECRET=                           # ✦  auto-generated if blank
POLAR_API_BASE_URL=https://api.polar.sh

# ── SDK publishing ───────────────────────────────────────────────────────────
# TypeScript SDK publishing.
NPM_TOKEN=
NPM_PUBLISH_ACCESS=restricted

# JVM SDK coordinates.
TESSERACT_JAVA_GROUP_ID=com.apollodeploy
TESSERACT_JAVA_ARTIFACT_ID=billing-sdk

# Remote Maven repository settings for the generated Kotlin SDK's Gradle publish task.
MAVEN_REPOSITORY_NAME=codeartifact
MAVEN_REPOSITORY_URL=
MAVEN_REPOSITORY_USERNAME=
MAVEN_REPOSITORY_PASSWORD=

# AWS CodeArtifact Maven repository settings. Run scripts/setup-codeartifact-maven-env.sh
# to create/use the repository and populate MAVEN_REPOSITORY_*.
AWS_REGION=us-east-1
AWS_PROFILE=
CODEARTIFACT_DOMAIN=apollo-deploy
CODEARTIFACT_DOMAIN_OWNER=
CODEARTIFACT_REPOSITORY=apollo-billing-sdk
CODEARTIFACT_REPOSITORY_DESCRIPTION="Apollo Deploy billing SDK Maven repository"
CODEARTIFACT_ROLE_ARN=
CODEARTIFACT_CREATE=1
CODEARTIFACT_ENV_PREFIX=MAVEN_REPOSITORY
CODEARTIFACT_REPOSITORY_NAME=codeartifact
CODEARTIFACT_BOOTSTRAP_PUBLISHER=auto
CODEARTIFACT_PUBLISHER_USER=codeartifact-maven-publisher
CODEARTIFACT_PUBLISHER_PROFILE=codeartifact-maven-publisher
CODEARTIFACT_PUBLISHER_POLICY_NAME=CodeArtifactMavenPublisherPolicy
CODEARTIFACT_UPSTREAM_REPOSITORIES=
CODEARTIFACT_EXTERNAL_CONNECTIONS=
CODEARTIFACT_VERIFY=1

# Optional POM metadata.
POM_URL=https://github.com/apollo-deploy/apollo-billing-api
POM_SCM_URL=https://github.com/apollo-deploy/apollo-billing-api
POM_SCM_CONNECTION=scm:git:https://github.com/apollo-deploy/apollo-billing-api.git
POM_SCM_DEVELOPER_CONNECTION=scm:git:ssh://git@github.com/apollo-deploy/apollo-billing-api.git
POM_DEVELOPER_ID=apollo-deploy
POM_DEVELOPER_NAME="Apollo Deploy"
